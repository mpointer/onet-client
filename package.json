{
  "name": "onet-client",
  "version": "0.1.0",
  "description": "Typed client for O*NET Web Services v2 (api-v2.onetcenter.org): occupation search and reports, details pagination, the Interest Profiler and Mini-IP, plus parsers for the O*NET bulk database files. Zero dependencies.",
  "license": "MIT",
  "author": "Michael Pointer <mpointer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpointer/onet-client.git"
  },
  "homepage": "https://github.com/mpointer/onet-client#readme",
  "bugs": "https://github.com/mpointer/onet-client/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "onet",
    "o*net",
    "onetcenter",
    "occupations",
    "careers",
    "interest-profiler",
    "riasec",
    "holland-codes",
    "soc",
    "bls",
    "labor"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
